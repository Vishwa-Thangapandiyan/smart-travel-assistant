# ---- Secrets : NEVER commit these ----
# We don't use a .env file (see RUN.md — config is passed via
# --dart-define), but this stays in case anything ever adds one back.
.env
.env.local
.env.*.local

# ---- Flutter / Dart ----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart

# ---- Platform build output ----
android/app/debug
android/app/profile
android/app/release
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Pods/
ios/.symlinks/

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
logs/
*.log

# ---- Misc ----
*.pem
.cache/

# ---- AI tooling: machine-local / generated state ----
# skills-lock.json (root) IS tracked on purpose — it's a lockfile
# (skill name -> source -> content hash), not runtime state.
# Everything below is either generated from that lockfile, installed by
# a plugin/skill installer, or personal machine config — none of it is
# hand-authored project content, and .claude/skills/* symlinks bake in
# an absolute path specific to this machine, so committing them would
# break on anyone else's checkout.
.agents/
.claude/skills/
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/live/
